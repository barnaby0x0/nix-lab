# Enable Powerlevel10k instant prompt. Should stay close to the top of /data/hm-files/.zshrc.
# Initialization code that may require console input (password prompts, [y/n]
# confirmations, etc.) must go above this block; everything else may go below.
if [[ -r "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh" ]]; then
  source "${XDG_CACHE_HOME:-$HOME/.cache}/p10k-instant-prompt-${(%):-%n}.zsh"
fi

# Oh My Zsh custom directory
export ZSH_CUSTOM="$HOME/.custom"

# PATH
export PATH="$HOME/.local/bin:$PATH"
export PATH="$HOME/bin:$PATH"

# Locale
export LANG="fr_FR.UTF-8"
export LC_MESSAGES="fr_FR.UTF-8"
export LC_ALL="fr_FR.UTF-8"

# GPG
export GPG_TTY="$(tty)"

# run-help
unalias run-help 2>/dev/null
alias help=run-help
autoload -Uz run-help

# Powerlevel10k
source /nix/store/a40w2ny56d6q3n9w96a8l9zy11dll7z5-powerlevel10k-1.20.15/share/zsh-powerlevel10k/powerlevel10k.zsh-theme

# Powerlevel10k configuration
[[ ! -f ~/.p10k.zsh ]] || source ~/.p10k.zsh

typeset -U path cdpath fpath manpath
for profile in ${(z)NIX_PROFILES}; do
  fpath+=($profile/share/zsh/site-functions $profile/share/zsh/$ZSH_VERSION/functions $profile/share/zsh/vendor-completions)
done

HELPDIR="/nix/store/v5grxq3yy7rkry3rpmqjk1cr95pkc6y2-zsh-5.9.2/share/zsh/$ZSH_VERSION/help"

source /nix/store/g1y6gn8v8yikw6xynk34b9ddv9il0yxa-zsh-autosuggestions-0.7.1/share/zsh-autosuggestions/zsh-autosuggestions.zsh
ZSH_AUTOSUGGEST_STRATEGY=(history)


# oh-my-zsh extra settings for plugins

# oh-my-zsh configuration generated by NixOS
plugins=(sudo)


source $ZSH/oh-my-zsh.sh

# History options should be set in .zshrc and after oh-my-zsh sourcing.
# See https://github.com/nix-community/home-manager/issues/177.
HISTSIZE="10000"
SAVEHIST="10000"

HISTFILE="$HOME/.zsh_history"
mkdir -p "$(dirname "$HISTFILE")"

# Set shell options
set_opts=(
  HIST_FCNTL_LOCK EXTENDED_HISTORY HIST_IGNORE_DUPS HIST_IGNORE_SPACE
  SHARE_HISTORY NO_APPEND_HISTORY NO_HIST_EXPIRE_DUPS_FIRST NO_HIST_FIND_NO_DUPS
  NO_HIST_IGNORE_ALL_DUPS NO_HIST_SAVE_NO_DUPS
)
for opt in "${set_opts[@]}"; do
  setopt "$opt"
done
unset opt set_opts

eval "$(/nix/store/9q13w144w01b3mmw7x9aylsjir6jy98a-direnv-2.37.1/bin/direnv hook zsh)"

alias -- cqt=cat
alias -- dotcrypt='GIT_DIR=$HOME/.dotfiles/ GIT_WORK_TREE=$HOME git-crypt'
alias -- dotfiles='/usr/bin/git --git-dir=$HOME/.dotfiles/ --work-tree=$HOME'
source /nix/store/6mbckzg4vw6kxxlyx0n3qkwsmqjnx9nd-zsh-syntax-highlighting-0.8.0/share/zsh-syntax-highlighting/zsh-syntax-highlighting.zsh
ZSH_HIGHLIGHT_HIGHLIGHTERS=(main)

# To customize prompt, run `p10k configure` or edit /data/hm-files/.p10k.zsh.
[[ ! -f /data/hm-files/.p10k.zsh ]] || source /data/hm-files/.p10k.zsh
